---
import { reposSnapshot } from '../data/repos';
import { site } from '../data/site';
import { getLang, intlLocale, useTranslations } from '../lib/i18n';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const updatedAt = new Date(reposSnapshot.generatedAt);
const updatedLabel = new Intl.DateTimeFormat(intlLocale[lang], {
  dateStyle: 'long',
  timeZone: 'America/Maceio',
}).format(updatedAt);
---

<footer class="mt-12 border-t border-border pt-8 text-sm text-muted">
  <p>
    {t('footer.madeBy', { name: site.name })}{' '}
    <time datetime={reposSnapshot.generatedAt}>{updatedLabel}</time>.
  </p>
  <p class="mt-2">
    <a
      href={site.sourceUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="underline decoration-border underline-offset-4 transition-colors hover:text-accent motion-reduce:transition-none"
    >
      {t('footer.source')}
      <span class="sr-only"> {t('a11y.newTab')}</span>
    </a>
  </p>
</footer>
