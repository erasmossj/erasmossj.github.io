---
import type { RepoLanguage } from '../lib/github/types';
import { getLang, intlLocale, useTranslations } from '../lib/i18n';

interface Props {
  languages: RepoLanguage[];
  /** Quantas linguagens listar na legenda (a barra mostra todas). */
  limit?: number;
}

const { languages, limit = 3 } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const fallbackColor = 'var(--muted)';
---

{languages.length > 0 && (
  <div>
    <div class="flex h-1.5 overflow-hidden rounded-full bg-border" aria-hidden="true">
      {languages.map((language) => (
        <span
          style={{
            width: `${language.percent}%`,
            backgroundColor: language.color ?? fallbackColor,
          }}
        />
      ))}
    </div>
    <ul
      class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-muted"
      aria-label={t('languages.label')}
    >
      {languages.slice(0, limit).map((language) => (
        <li class="flex items-center gap-1.5">
          <span
            class="size-2 rounded-full"
            style={{ backgroundColor: language.color ?? fallbackColor }}
            aria-hidden="true"
          />
          {language.name}
          <span class="font-mono">{language.percent.toLocaleString(intlLocale[lang])}%</span>
        </li>
      ))}
    </ul>
  </div>
)}
