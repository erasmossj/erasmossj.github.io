---
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
---

<div class="sticky top-0 z-40 border-b border-border bg-bg/90 backdrop-blur lg:hidden">
  <div class="mx-auto flex h-14 max-w-screen-xl items-center justify-between px-6 md:px-12">
    <a href="#conteudo" class="font-mono text-sm font-semibold text-accent">
      {site.name}
    </a>
    <div class="flex items-center gap-1">
      <ThemeToggle />
      <details class="group relative" data-mobile-menu>
        <summary
          class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full text-muted hover:text-accent [&::-webkit-details-marker]:hidden"
          aria-label="Menu de seções"
        >
          <svg
            class="size-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path class="group-open:hidden" d="M4 7h16M4 12h16M4 17h16"></path>
            <path class="hidden group-open:block" d="M6 6l12 12M18 6 6 18"></path>
          </svg>
        </summary>
        <nav
          class="absolute right-0 mt-2 w-56 rounded-card border border-border bg-surface p-2 shadow-lg"
          aria-label="Seções"
        >
          <ol>
            {site.nav.map((item, index) => (
              <li>
                <a
                  href={`#${item.id}`}
                  data-nav-link
                  class="flex gap-3 rounded-md px-3 py-2 text-sm text-muted hover:text-text aria-[current=location]:text-accent"
                >
                  <span class="font-mono">{String(index + 1).padStart(2, '0')}</span>
                  {item.label}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
    </div>
  </div>
</div>

<script>
  // Fecha o menu ao escolher uma seção.
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => menu.removeAttribute('open'));
  });
</script>
