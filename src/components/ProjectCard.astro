---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import type { Project } from '../lib/projects';
import LanguageBar from './LanguageBar.astro';

interface Props {
  project: Project;
  /** Card principal do bento: título maior e mais linguagens na legenda. */
  hero?: boolean;
}

const { project, hero = false } = Astro.props;

// Imagens ficam em src/assets/projetos/ e são referenciadas pelo nome do arquivo na curadoria.
const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/projetos/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);
const image = project.image ? images[`../assets/projetos/${project.image}`]?.default : undefined;
const linkClass = 'transition-colors hover:text-accent motion-reduce:transition-none';
---

<article class="flex w-full flex-col rounded-card border border-border bg-surface p-6 transition-colors focus-within:border-accent hover:border-accent motion-reduce:transition-none">
  {image && (
    <Picture
      src={image}
      formats={['avif', 'webp']}
      widths={[400, 800]}
      sizes="(min-width: 640px) 50vw, 100vw"
      alt={`Prévia de ${project.title}`}
      class="mb-5 aspect-video w-full rounded-md object-cover"
    />
  )}
  {project.context && <p class="font-mono text-xs text-accent">{project.context}</p>}
  <h3 class:list={['mt-2 font-semibold tracking-tight', hero ? 'text-xl' : 'text-lg']}>
    {project.title}
  </h3>
  {project.tagline && <p class="mt-2 text-sm leading-relaxed text-muted">{project.tagline}</p>}
  {project.highlight && (
    <p class="mt-3 text-sm leading-relaxed">
      <span class="font-semibold">Destaque técnico:</span>
      {project.highlight}
    </p>
  )}
  {project.topics.length > 0 && (
    <ul class="mt-4 flex flex-wrap gap-2" aria-label="Tópicos">
      {project.topics.map((topic) => (
        <li class="rounded-full border border-border px-2.5 py-0.5 font-mono text-xs text-muted">
          {topic}
        </li>
      ))}
    </ul>
  )}
  <div class="mt-auto pt-5">
    <LanguageBar languages={project.languages} limit={hero ? 4 : 3} />
  </div>
  <div class="mt-5 flex gap-5 text-sm font-semibold">
    <a href={project.url} target="_blank" rel="noopener noreferrer" class={linkClass}>
      Código<span class="sr-only"> de {project.title} (abre em nova aba)</span>
      <span aria-hidden="true">↗</span>
    </a>
    {project.demoUrl && (
      <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
        Demo<span class="sr-only"> de {project.title} (abre em nova aba)</span>
        <span aria-hidden="true">↗</span>
      </a>
    )}
  </div>
</article>
