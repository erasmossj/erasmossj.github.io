---
interface Props {
  id: string;
  title: string;
  number: number;
}

const { id, title, number } = Astro.props;
const headingId = `${id}-titulo`;
---

<section {id} aria-labelledby={headingId} class="scroll-mt-20 py-12 first:pt-0 lg:scroll-mt-24">
  <h2 id={headingId} class="mb-8 flex items-center gap-3 text-2xl font-bold tracking-tight">
    <span class="font-mono text-base font-normal text-accent">
      {String(number).padStart(2, '0')}.
    </span>
    {title}
    <span class="ml-4 h-px max-w-60 flex-1 bg-border" aria-hidden="true"></span>
  </h2>
  <slot />
</section>
