---
import { site } from '../data/site';
import SocialLinks from './SocialLinks.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="pt-12 pb-16 lg:sticky lg:top-0 lg:flex lg:max-h-dvh lg:flex-col lg:justify-between lg:py-24">
  <div>
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
      <a href="/">{site.name}</a>
    </h1>
    <p class="mt-3 text-lg font-medium">{site.role}</p>
    <p class="mt-4 max-w-xs leading-relaxed text-muted">{site.pitch}</p>

    <nav class="mt-16 hidden lg:block" aria-label="Seções">
      <ol class="space-y-1">
        {site.nav.map((item, index) => (
          <li>
            <a
              href={`#${item.id}`}
              data-nav-link
              class="group flex items-center gap-4 py-2 text-xs font-semibold tracking-widest text-muted uppercase transition-colors hover:text-text aria-[current=location]:text-accent"
            >
              <span
                class="h-px w-8 bg-current transition-all group-hover:w-16 group-aria-[current=location]:w-16 motion-reduce:transition-none"
                aria-hidden="true"
              />
              <span class="font-mono">{String(index + 1).padStart(2, '0')}</span>
              {item.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>

  <div class="mt-8 flex items-center justify-between">
    <SocialLinks />
    <div class="hidden lg:block">
      <ThemeToggle />
    </div>
  </div>
</header>
