---
import { site } from '../data/site';
import { getLang, localize, useTranslations } from '../lib/i18n';
import type { LanguageFilter } from '../lib/languages';

interface Props {
  /** Linguagens principais dos repositórios, da mais usada para a menos. */
  languages: LanguageFilter[];
}

const { languages } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const groups = [
  { title: t('skills.languages'), items: languages.map((language) => language.name) },
  { title: t('skills.tools'), items: localize(site.skills.tools, lang) },
  { title: t('skills.interests'), items: localize(site.skills.interests, lang) },
];
---

<div class="grid gap-8 sm:grid-cols-3">
  {groups.map((group) => (
    <div>
      <h3 class="font-mono text-xs font-semibold tracking-widest text-accent uppercase">
        {group.title}
      </h3>
      <ul class="mt-4 flex flex-wrap gap-2">
        {group.items.map((item) => (
          <li class="rounded-full border border-border bg-surface px-3 py-1 text-sm">{item}</li>
        ))}
      </ul>
    </div>
  ))}
</div>
