---
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import MobileHeader from '../components/MobileHeader.astro';
import Sidebar from '../components/Sidebar.astro';
import { site } from '../data/site';
import {
  defaultLang,
  getLang,
  htmlLang,
  languages,
  localize,
  ogLocale,
  pathFor,
  useTranslations,
} from '../lib/i18n';
import { ogImagePath, personJsonLd, serializeJsonLd } from '../lib/seo';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const {
  title = `${site.name} · ${t('meta.portfolio')}`,
  description = t('meta.description', { name: site.fullName }),
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// A mesma página nos outros idiomas, para os buscadores (hreflang) e as prévias (og:locale).
const alternates = languages.map((other) => ({
  hreflang: htmlLang[other],
  href: new URL(pathFor(other), Astro.site),
}));
const otherLangs = languages.filter((other) => other !== lang);
const ogImage = new URL(ogImagePath(lang), Astro.site);
const ogImageAlt = `${site.name} · ${localize(site.role, lang)}`;
const jsonLd = serializeJsonLd(
  personJsonLd(
    {
      name: site.name,
      fullName: site.fullName,
      jobTitle: t('person.jobTitle'),
      institution: localize(site.education.institution, lang),
      sameAs: site.socials.map((social) => social.href),
    },
    new URL(pathFor(lang), Astro.site).href,
  ),
);
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical} />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(pathFor(defaultLang), Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>

    <!-- Prévia ao compartilhar o link (LinkedIn, WhatsApp, X etc.). -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale[lang]} />
    {otherLangs.map((other) => (
      <meta property="og:locale:alternate" content={ogLocale[other]} />
    ))}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" set:html={jsonLd} />
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />
    <!-- Aplica o tema antes da primeira pintura para não "piscar". -->
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {
          /* storage bloqueado: usa a preferência do sistema */
        }
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="min-h-dvh">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-card focus:bg-surface focus:px-4 focus:py-2"
    >
      {t('a11y.skip')}
    </a>
    <MobileHeader />
    <div class="mx-auto max-w-screen-xl px-6 md:px-12 lg:grid lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16 lg:px-16">
      <Sidebar />
      <main id="conteudo" class="pb-24 lg:py-24">
        <slot />
        <Footer />
      </main>
    </div>
  </body>
</html>

<script>
  // Destaca no menu a seção ativa: a última cujo topo já chegou perto do alto da tela
  // (ou a última de todas, quando a página chega ao fim).
  const ACTIVE_OFFSET = 160; // px; maior que o scroll-margin das seções (80–96px)
  const links = document.querySelectorAll<HTMLAnchorElement>('a[data-nav-link]');
  const sections = [...document.querySelectorAll<HTMLElement>('main section[id]')];

  function updateActive() {
    const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
    let active = sections[0];
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= ACTIVE_OFFSET) active = section;
    }
    if (atBottom) active = sections[sections.length - 1];

    for (const link of links) {
      if (link.hash === `#${active?.id}`) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  }

  let ticking = false;
  addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        updateActive();
        ticking = false;
      });
    },
    { passive: true },
  );
  updateActive();
</script>
