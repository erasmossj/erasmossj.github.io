---
import About from '../components/About.astro';
import Section from '../components/Section.astro';
import { projectsConfig } from '../data/projects.config';
import { reposSnapshot } from '../data/repos';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { mergeProjects } from '../lib/projects';

const { projects, warnings } = mergeProjects(reposSnapshot.repos, projectsConfig);
for (const warning of warnings) console.warn(`⚠ ${warning}`);
const featured = projects.filter((project) => project.featured);

// O conteúdo das demais seções entra no Sprint 3 (SCRUM-21 a SCRUM-23).
const pending: Record<string, string> = {
  destaques: `${featured.length} projetos em destaque no bento grid — em construção (Sprint 3).`,
  repositorios: `${projects.length} repositórios com filtro por linguagem — em construção (Sprint 3).`,
  skills: 'Linguagens e ferramentas — em construção (Sprint 3).',
  formacao: 'Ciência da Computação — UFAL. Detalhes em construção (Sprint 3).',
  contato: 'Formas de contato — em construção (Sprint 3).',
};
---

<BaseLayout>
  {site.nav.map((item, index) => (
    <Section id={item.id} title={item.label} number={index + 1}>
      {item.id === 'sobre' ? (
        <About />
      ) : (
        <p class="rounded-card border border-dashed border-border p-6 text-muted">
          {pending[item.id]}
        </p>
      )}
    </Section>
  ))}
</BaseLayout>
