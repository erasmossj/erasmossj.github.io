---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="mx-auto flex min-h-dvh max-w-2xl flex-col justify-center gap-4 px-6">
    <p class="font-mono text-sm text-teal-300">Olá, eu sou</p>
    <h1 class="text-4xl font-bold text-slate-50 sm:text-5xl">Erasmo Junior</h1>
    <p class="text-lg text-slate-300">
      Estudante de Ciência da Computação na UFAL. Este portfólio está em construção.
    </p>
    <p>
      <a
        class="text-teal-300 underline underline-offset-4 hover:text-teal-200"
        href="https://github.com/erasmossj"
      >
        Ver meus projetos no GitHub
      </a>
    </p>
  </main>
</Layout>
