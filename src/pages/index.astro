---
import About from '../components/About.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import RepoList from '../components/RepoList.astro';
import Section from '../components/Section.astro';
import { projectsConfig } from '../data/projects.config';
import { reposSnapshot } from '../data/repos';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { mergeProjects } from '../lib/projects';

const { projects, warnings } = mergeProjects(reposSnapshot.repos, projectsConfig);
for (const warning of warnings) console.warn(`⚠ ${warning}`);
const featured = projects.filter((project) => project.featured);

// Numeração das seções segue a ordem do menu.
const number = (id: string) => site.nav.findIndex((item) => item.id === id) + 1;
const title = (id: string) => site.nav.find((item) => item.id === id)?.label ?? id;

// O conteúdo destas seções entra no próximo item do Sprint 3 (SCRUM-23).
const pending: Record<string, string> = {
  skills: 'Linguagens e ferramentas — em construção (Sprint 3).',
  formacao: 'Ciência da Computação — UFAL. Detalhes em construção (Sprint 3).',
  contato: 'Formas de contato — em construção (Sprint 3).',
};
---

<BaseLayout>
  <Section id="sobre" title={title('sobre')} number={number('sobre')}>
    <About />
  </Section>

  <Section id="destaques" title={title('destaques')} number={number('destaques')}>
    <FeaturedProjects projects={featured} />
  </Section>

  <Section id="repositorios" title={title('repositorios')} number={number('repositorios')}>
    <RepoList {projects} />
  </Section>

  {Object.entries(pending).map(([id, text]) => (
    <Section {id} title={title(id)} number={number(id)}>
      <p class="rounded-card border border-dashed border-border p-6 text-muted">{text}</p>
    </Section>
  ))}
</BaseLayout>
